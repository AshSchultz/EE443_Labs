/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off Lab8 -c Lab8 --vector_source="/home/ashinashell/class-coding/EE443_Labs/Lab_8/Waveform6.vwf" --testbench_file="/home/ashinashell/class-coding/EE443_Labs/Lab_8/simulation/qsim/Waveform6.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off Lab8 -c Lab8 --vector_source="/home/ashinashell/class-coding/EE443_Labs/Lab_8/Waveform6.vwf" --testbench_file="/home/ashinashell/class-coding/EE443_Labs/Lab_8/simulation/qsim/Waveform6.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="/home/ashinashell/class-coding/EE443_Labs/Lab_8/simulation/qsim/" Lab8 -c Lab8</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="/home/ashinashell/class-coding/EE443_Labs/Lab_8/simulation/qsim/" Lab8 -c Lab8</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work Lab8.vho
vcom -work work Waveform6.vwf.vht
vsim -novopt -c -t 1ps -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.m16dp1_vhd_vec_tst
vcd file -direction Lab8.msim.vcd
vcd add -internal m16dp1_vhd_vec_tst/*
vcd add -internal m16dp1_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work Lab8.vho
vcom -work work Waveform6.vwf.vht
vsim -novopt -c -t 1ps -sdfmax m16dp1_vhd_vec_tst/i1=Lab8_vhd.sdo -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.m16dp1_vhd_vec_tst
vcd file -direction Lab8.msim.vcd
vcd add -internal m16dp1_vhd_vec_tst/*
vcd add -internal m16dp1_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
